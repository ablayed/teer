{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm biome check --write $CLAUDE_TOOL_INPUT_FILE_PATH"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.env.*.local)"]
  }
}
