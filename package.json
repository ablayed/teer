{
  "name": "teer",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:s1d2:format": "vitest run tests/unit/s1d2-backup-format.test.ts",
    "test:s1d2:local-cycle": "node scripts/s1d2-local-cycle.mjs",
    "test:s1d3:incident": "vitest run tests/unit/security/s1d3-access-incident.test.ts",
    "test:s1d4:boundaries": "vitest run tests/unit/security/s1d4-environment-dlp.test.ts",
    "test:s1d4:fonts": "vitest run tests/unit/security/s1d4-fonts.test.ts",
    "security:s1d4:client-bundle": "node scripts/s1d4-check-client-bundle.mjs",
    "security:acl-baseline:generate": "node scripts/generate-acl-baseline.mjs",
    "security:acl-baseline:check": "node scripts/generate-acl-baseline.mjs --check",
    "security:acl-production-probe": "node scripts/acl-production-probe.mjs",
    "test:rls": "vitest run tests/rls",
    "test:e2e": "playwright test tests/e2e",
    "test:e2e:shopify": "node scripts/test-shopify-webhooks.mjs",
    "shopify:webhook-migration:plan": "node scripts/webhook-subscription-migration.mjs --plan",
    "shopify:webhook-migration:apply": "node scripts/webhook-subscription-migration.mjs --apply",
    "test:visual:desktop": "playwright test tests/visual --project=chromium",
    "test:visual:mobile": "playwright test tests/visual --project=pixel-7 --project=iphone-14",
    "db:types": "supabase gen types typescript --linked > lib/supabase/database.types.ts && biome format --write lib/supabase/database.types.ts && node scripts/apply-database-types-overrides.mjs"
  },
  "dependencies": {
    "@ai-sdk/groq": "3.0.39",
    "@ai-sdk/react": "3.0.199",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-popover": "^1.1.18",
    "@react-pdf/renderer": "4.5.1",
    "@sentry/nextjs": "^9.0.0",
    "@supabase/ssr": "^0.6.0",
    "@supabase/supabase-js": "^2.49.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "ai": "6.0.197",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.0.0",
    "geist": "^1.3.1",
    "lucide-react": "^0.468.0",
    "next": "^15.0.0",
    "next-intl": "^4.13.0",
    "next-safe-action": "^8.0.0",
    "nuqs": "^2.9.0",
    "posthog-js": "^1.200.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "resend": "^4.0.0",
    "tailwind-merge": "^2.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.50.0",
    "@shopify/cli": "^4.1.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "2.1.9",
    "fake-indexeddb": "^6.2.5",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "pg": "^8.21.0",
    "supabase": "2.102.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@9.15.0",
  "browserslist": [
    "chrome >= 109",
    "edge >= 109",
    "firefox >= 115",
    "safari >= 15.4",
    "ios_saf >= 15.4",
    "samsung >= 21",
    "not dead"
  ]
}
